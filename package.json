{
  "name": "expo-starter",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "lint": "expo lint .",
    "fix": "expo lint . --fix",
    "typecheck": "tsc",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "doctor": "expo install --fix && expo-doctor",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "start": "expo start",
    "client": "expo start --dev-client",
    "reset": "expo start -c",
    "prebuild": "expo prebuild --clean",
    "build:production": "eas build --profile production",
    "build:staging": "eas build --profile staging",
    "run": "eas build:run",
    "update": "eas update",
    "update:bump": "rific-bump-ota",
    "submit": "eas submit",
    "android": "expo run:android",
    "ios": "expo run:ios"
